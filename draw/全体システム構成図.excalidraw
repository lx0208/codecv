      "locked": false,
      "fontSize": 15,
      "fontFamily": 6,
      "text": "・3000/TCP：OpenWebUI（外部）\n・4000/TCP：LiteLLM（内部/外部API）\n・5432/TCP：PostgreSQL（内部）\n・8000/TCP：vLLM（DGX側、内部通信のみ推奨）",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 75,
      "containerId": null,
      "originalText": "・3000/TCP：OpenWebUI（外部）\n・4000/TCP：LiteLLM（内部/外部API）\n・5432/TCP：PostgreSQL（内部）\n・8000/TCP：vLLM（DGX側、内部通信のみ推奨）",
      "lineHeight": 1.35,
      "index": "b0C",
      "autoResize": true
    },
